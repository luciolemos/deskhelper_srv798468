{% extends 'layouts/deskhelper-dashboard.twig' %}

{% block title %}Dashboard Operator | Deskhelper{% endblock %}

{% block head %}
  <style>
  </style>
{% endblock %}

{% block deskhelper_shell_title %}Fila operacional{% endblock %}
{% block deskhelper_shell_subtitle %}Execução diária de tickets e priorização da fila.{% endblock %}

{% block deskhelper_main %}
  {% set statusLabels = {
    'open': 'Aberto',
    'in_progress': 'Em andamento',
    'resolved': 'Resolvido',
    'closed': 'Fechado',
    'cancelled': 'Cancelado'
  } %}
  {% set priorityLabels = {
    'low': 'Baixa',
    'medium': 'Média',
    'high': 'Alta'
  } %}
  {% set sortIcons = {
    'asc': 'bi-caret-up-fill',
    'desc': 'bi-caret-down-fill'
  } %}

  {% if dashboardPanel == 'overview' %}
  <div class="dh-kpi-grid">
    <a class="dh-kpi-link" href="{{ app_url('tickets?view=list&scope=created') }}">
      {% include 'components/deskhelper-kpi-card.twig' with { label: 'Meus tickets', value: summary.myTickets|default(0), subtitle: 'Ocorrências abertas por você no ambiente' } %}
    </a>
    <a class="dh-kpi-link" href="{{ app_url('tickets?view=list&scope=assigned') }}">
      {% include 'components/deskhelper-kpi-card.twig' with { label: 'Atribuídos', value: summary.assignedTickets|default(0), subtitle: 'Tickets atualmente sob sua responsabilidade' } %}
    </a>
    <a class="dh-kpi-link" href="{{ app_url('tickets?view=list&status=open') }}">
      {% include 'components/deskhelper-kpi-card.twig' with { label: 'Abertos', value: summary.status.open|default(0), subtitle: 'Tickets visíveis ao seu perfil ainda sem andamento' } %}
    </a>
    <a class="dh-kpi-link" href="{{ app_url('tickets?view=list&status=in_progress') }}">
      {% include 'components/deskhelper-kpi-card.twig' with { label: 'Em andamento', value: summary.status.in_progress|default(0), subtitle: 'Tickets em execução por você ou no seu escopo' } %}
    </a>
    <a class="dh-kpi-link" href="{{ app_url('tickets?view=list&priority=high') }}">
      {% include 'components/deskhelper-kpi-card.twig' with { label: 'Prioridade alta', value: summary.highPriorityOpen|default(0), subtitle: 'Ocorrências críticas dentro do seu escopo atual' } %}
    </a>
  </div>
  {% elseif dashboardPanel == 'actions' %}
  <div class="dh-kpi-grid">
    <a class="dh-kpi-link" href="{{ app_url('tickets?view=list&status=in_progress') }}">
      {% include 'components/deskhelper-kpi-card.twig' with { label: 'Continuar atendimentos', value: summary.status.in_progress|default(0), subtitle: 'Tickets já em execução sob sua responsabilidade' } %}
    </a>
    <a class="dh-kpi-link" href="{{ app_url('tickets?view=list&scope=assigned') }}">
      {% include 'components/deskhelper-kpi-card.twig' with { label: 'Atribuídos a mim', value: summary.assignedTickets|default(0), subtitle: 'Tickets já sob sua condução' } %}
    </a>
    <a class="dh-kpi-link" href="{{ app_url('tickets?view=list&status=open') }}">
      {% include 'components/deskhelper-kpi-card.twig' with { label: 'Abertos no meu escopo', value: summary.status.open|default(0), subtitle: 'Tickets próprios ou já atribuídos a você' } %}
    </a>
    <a class="dh-kpi-link" href="{{ app_url('tickets?view=list&priority=high') }}">
      {% include 'components/deskhelper-kpi-card.twig' with { label: 'Prioridade alta', value: summary.highPriorityOpen|default(0), subtitle: 'Itens críticos no seu escopo atual' } %}
    </a>
  </div>
  {% elseif dashboardPanel == 'category_summary' %}
  <div class="dh-kpi-grid">
    {% for item in summary.categorySummary %}
      <a class="dh-kpi-link" href="{{ app_url('tickets?view=list&category_id=' ~ item.id) }}">
        {% include 'components/deskhelper-kpi-card.twig' with {
          label: item.label,
          value: item.total,
          subtitle: item.total == 1 ? '1 ticket nesta categoria no seu escopo' : item.total ~ ' tickets nesta categoria no seu escopo'
        } %}
      </a>
    {% else %}
      <article class="db-card">
        <div class="db-card-body">
          <p class="db-card-subtitle">Sem dados suficientes.</p>
        </div>
      </article>
    {% endfor %}
  </div>
  {% elseif dashboardPanel == 'recent' %}
  <form class="db-contact-form db-admin-filters dh-search-panel" method="get" action="{{ app_url('app') }}">
    <input type="hidden" name="panel" value="recent">
    <div class="dh-search-panel__grid" style="grid-template-columns:minmax(0, 1.7fr) minmax(150px, 0.7fr) minmax(150px, 0.7fr);">
      <label class="dh-search-panel__search">
        <span class="dh-search-panel__label">Busca</span>
        <div class="dh-search-panel__input-wrap">
          <i class="bi bi-search" aria-hidden="true"></i>
          <input type="text" name="q" value="{{ summary.recentFilters.q|default(filters.q|default('')) }}" placeholder="Buscar por ID, título, status, prioridade ou categoria">
        </div>
      </label>
      <label class="dh-search-panel__field">
        <span class="dh-search-panel__label">Status</span>
        <select name="status">
          <option value="">Todos</option>
          {% for status in ['open', 'in_progress', 'resolved', 'closed', 'cancelled'] %}
            <option value="{{ status }}" {{ summary.recentFilters.status|default('') == status ? 'selected' : '' }}>{{ statusLabels[status] }}</option>
          {% endfor %}
        </select>
      </label>
      <label class="dh-search-panel__field">
        <span class="dh-search-panel__label">Prioridade</span>
        <select name="priority">
          <option value="">Todas</option>
          {% for priority in ['low', 'medium', 'high'] %}
            <option value="{{ priority }}" {{ summary.recentFilters.priority|default('') == priority ? 'selected' : '' }}>{{ priorityLabels[priority] }}</option>
          {% endfor %}
        </select>
      </label>
    </div>
    <div class="db-contact-actions dh-search-panel__actions">
      <button class="db-card-link" type="submit">Filtrar</button>
      <a class="db-card-link db-card-link-secondary" href="{{ app_url('app?panel=recent') }}">Limpar</a>
    </div>
  </form>

  <div class="dh-list-controls">
    <div class="dh-list-controls__group db-contact-actions">
      {% include 'components/deskhelper-overview-link.twig' %}
      <form method="get" action="{{ app_url('app') }}" style="display:inline;">
        <input type="hidden" name="panel" value="recent">
        <input type="hidden" name="q" value="{{ summary.recentFilters.q|default('') }}">
        <input type="hidden" name="status" value="{{ summary.recentFilters.status|default('') }}">
        <input type="hidden" name="priority" value="{{ summary.recentFilters.priority|default('') }}">
        <input type="hidden" name="sort" value="{{ summary.recentSort|default('updated_at') }}">
        <input type="hidden" name="dir" value="{{ summary.recentDirection|default('desc') }}">
        <label class="dh-inline-select">
          <span>Exibir</span>
          <select name="per_page" onchange="this.form.submit()">
            {% for option in ['5', '10', '15', '20', '25', '50', '100', 'all'] %}
              <option value="{{ option }}" {{ summary.recentPagination.per_page|default('10') == option ? 'selected' : '' }}>
                {{ option == 'all' ? 'Todos' : option }}
              </option>
            {% endfor %}
          </select>
        </label>
      </form>
    </div>
    <div class="dh-list-controls__summary">{{ summary.recentPagination.from|default(0) }}-{{ summary.recentPagination.to|default(summary.recentTickets|length) }} de {{ summary.recentPagination.total_items|default(summary.recentTickets|length) }} ticket(s)</div>
  </div>

  {% if summary.recentTickets is empty %}
    <p class="db-card-subtitle">Nenhum ticket encontrado para os recentes atuais.</p>
  {% else %}
    {% set tableContent %}
      <thead>
        <tr>
          <th><a href="{{ app_url('app?' ~ (summary.recentQuery|merge({sort: 'id', dir: summary.recentSort == 'id' and summary.recentDirection == 'asc' ? 'desc' : 'asc', page: 1})|url_encode)) }}">ID {% if summary.recentSort == 'id' %}<i class="bi {{ sortIcons[summary.recentDirection] }}"></i>{% endif %}</a></th>
          <th><a href="{{ app_url('app?' ~ (summary.recentQuery|merge({sort: 'title', dir: summary.recentSort == 'title' and summary.recentDirection == 'asc' ? 'desc' : 'asc', page: 1})|url_encode)) }}">Título {% if summary.recentSort == 'title' %}<i class="bi {{ sortIcons[summary.recentDirection] }}"></i>{% endif %}</a></th>
          <th><a href="{{ app_url('app?' ~ (summary.recentQuery|merge({sort: 'status', dir: summary.recentSort == 'status' and summary.recentDirection == 'asc' ? 'desc' : 'asc', page: 1})|url_encode)) }}">Status {% if summary.recentSort == 'status' %}<i class="bi {{ sortIcons[summary.recentDirection] }}"></i>{% endif %}</a></th>
          <th><a href="{{ app_url('app?' ~ (summary.recentQuery|merge({sort: 'priority', dir: summary.recentSort == 'priority' and summary.recentDirection == 'asc' ? 'desc' : 'asc', page: 1})|url_encode)) }}">Prioridade {% if summary.recentSort == 'priority' %}<i class="bi {{ sortIcons[summary.recentDirection] }}"></i>{% endif %}</a></th>
          <th><a href="{{ app_url('app?' ~ (summary.recentQuery|merge({sort: 'updated_at', dir: summary.recentSort == 'updated_at' and summary.recentDirection == 'asc' ? 'desc' : 'asc', page: 1})|url_encode)) }}">Atualizado {% if summary.recentSort == 'updated_at' %}<i class="bi {{ sortIcons[summary.recentDirection] }}"></i>{% endif %}</a></th>
        </tr>
      </thead>
      <tbody>
        {% for item in summary.recentTickets %}
          <tr>
            <td><a href="{{ app_url('tickets/' ~ item.id) }}" hx-boost="false">#{{ item.id }}</a></td>
            <td>{{ item.title }}</td>
            <td>{% include 'components/deskhelper-status-pill.twig' with { status: item.status } %}</td>
            <td>{% include 'components/deskhelper-priority-pill.twig' with { priority: item.priority } %}</td>
            <td>{{ item.updated_at }}</td>
          </tr>
        {% endfor %}
      </tbody>
    {% endset %}
    {% include 'components/deskhelper-table-shell.twig' with { content: tableContent, tableClass: 'db-table db-admin-list-table' } %}
    {% if summary.recentPagination.total_pages|default(1) > 1 %}
      <div class="dh-toolbar-inline dh-pagination-bar">
        <div class="db-contact-actions">
          {% if summary.recentPagination.has_prev %}
            <a class="db-card-link db-card-link-secondary" href="{{ app_url('app?' ~ (summary.recentQuery|merge({page: summary.recentPagination.prev_page})|url_encode)) }}">Anterior</a>
          {% else %}
            <span class="db-card-link db-card-link-secondary is-disabled" aria-disabled="true">Anterior</span>
          {% endif %}
          {% if summary.recentPagination.has_next %}
            <a class="db-card-link db-card-link-secondary" href="{{ app_url('app?' ~ (summary.recentQuery|merge({page: summary.recentPagination.next_page})|url_encode)) }}">Próxima</a>
          {% else %}
            <span class="db-card-link db-card-link-secondary is-disabled" aria-disabled="true">Próxima</span>
          {% endif %}
        </div>
        <div class="dh-result-summary">Página {{ summary.recentPagination.page }} de {{ summary.recentPagination.total_pages }}</div>
      </div>
    {% endif %}
  {% endif %}
  {% endif %}
{% endblock %}
