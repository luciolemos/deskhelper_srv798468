<header class="db-navbar" aria-label="Barra superior do deskhelper">
  {% set roleLabel = deskhelper_session_user.is_admin ? 'Administrador' : (deskhelper_session_user.is_operator ? 'Operador' : 'Usuário') %}
  {% set rankShort = {
    'General de Exército': 'Gen Ex',
    'General de Divisão': 'Gen Div',
    'General de Brigada': 'Gen Bda',
    'Coronel': 'Cel',
    'Tenente-Coronel': 'Ten Cel',
    'Major': 'Maj',
    'Capitão': 'Cap',
    '1º Tenente': '1º Ten',
    '2º Tenente': '2º Ten',
    'Aspirante a Oficial': 'Asp Of',
    'Subtenente': 'ST',
    '1º Sargento': '1º Sgt',
    '2º Sargento': '2º Sgt',
    '3º Sargento': '3º Sgt',
    'Cabo': 'Cb',
    'Soldado': 'Sd'
  } %}
  {% set userIdentityLabel = ([rankShort[deskhelper_session_user.rank|default('')]|default(deskhelper_session_user.rank|default('')), deskhelper_session_user.name|default('Usuário')]|filter(v => v is not same as('') and v is not null)|join(' ')) %}
  <div class="db-navbar-row">
    <div class="db-navbar-actions">
      <div class="db-navbar-left">
        <button
          type="button"
          class="db-sidebar-toggle"
          data-sidebar-toggle
          aria-controls="db-sidebar"
          aria-expanded="false"
          aria-label="Alternar menu lateral"
        >
          <i class="bi bi-list" aria-hidden="true"></i>
        </button>
      </div>

      <div class="db-navbar-right">
        {% if deskhelper_session_user.is_admin %}
          {% set adminNotificationCount = deskhelper_admin_notifications.total|default(0) %}
          <details class="db-notification-menu">
            <summary
              class="db-notification-toggle"
              aria-label="Abrir notificações administrativas"
              title="{{ adminNotificationCount > 0 ? adminNotificationCount ~ ' alerta(s) administrativo(s)' : 'Sem alertas administrativos' }}"
            >
              <i class="bi bi-bell" aria-hidden="true"></i>
              <span class="db-notification-badge{{ adminNotificationCount == 0 ? ' is-zero' : '' }}">{{ adminNotificationCount }}</span>
            </summary>
            <div class="db-notification-panel" role="menu" aria-label="Alertas administrativos">
              <div class="db-notification-header">
                <strong>Alertas</strong>
                <span>{{ adminNotificationCount }} no total</span>
              </div>
              <div class="db-notification-list">
                {% for item in deskhelper_admin_notifications.items|default([]) %}
                  <a class="db-notification-item" href="{{ item.url }}" hx-boost="false" role="menuitem">
                    <span class="db-notification-item-title">{{ item.title }}{% if item.count is defined %} · {{ item.count }}{% endif %}</span>
                    <span class="db-notification-item-meta">{{ item.meta }}</span>
                  </a>
                {% else %}
                  <p class="db-notification-empty">Nenhuma notificação administrativa no momento.</p>
                {% endfor %}
              </div>
              <a class="db-notification-footer" href="{{ app_url('admin/users/pending?view=list') }}" hx-boost="false">Abrir fila administrativa</a>
            </div>
          </details>
        {% endif %}
        <details class="db-user-menu">
          <summary class="db-user-menu-toggle" aria-label="Abrir menu do usuário">
            <span class="db-user-avatar{{ deskhelper_session_user.avatar_url|default('') ? '' : ' is-fallback' }}" data-initial="{{ deskhelper_session_user.name|default('U')|slice(0, 1)|upper }}" aria-hidden="true">
              {% if deskhelper_session_user.avatar_url|default('') %}
                <img src="{{ deskhelper_session_user.avatar_url }}" alt="Foto do usuário" loading="lazy">
              {% endif %}
            </span>
            <span class="db-user-menu-meta">
              <span class="db-user-name">{{ userIdentityLabel }}</span>
              <span class="db-user-role">{{ roleLabel }}</span>
            </span>
            <i class="bi bi-chevron-down" aria-hidden="true"></i>
          </summary>
          <div class="db-user-menu-panel" role="menu" aria-label="Menu do usuário">
            <div class="db-user-menu-header">
              <span class="db-user-avatar{{ deskhelper_session_user.avatar_url|default('') ? '' : ' is-fallback' }}" data-initial="{{ deskhelper_session_user.name|default('U')|slice(0, 1)|upper }}" aria-hidden="true">
                {% if deskhelper_session_user.avatar_url|default('') %}
                  <img src="{{ deskhelper_session_user.avatar_url }}" alt="Foto do usuário" loading="lazy">
                {% endif %}
              </span>
              <div class="db-user-menu-identity">
                <strong>{{ userIdentityLabel }}</strong>
                <span>{{ roleLabel }}</span>
              </div>
            </div>
            <a class="db-user-menu-item" href="{{ app_url('account') }}" hx-boost="false" role="menuitem">
              <i class="bi bi-person-circle" aria-hidden="true"></i>
              <span>Minha conta</span>
            </a>
            <form method="post" action="{{ app_url('logout') }}" hx-boost="false" class="db-user-menu-form">
              <input type="hidden" name="csrf_token" value="{{ csrfToken|default('') }}">
              <button class="db-user-menu-item is-danger" type="submit">
                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                <span>Sair</span>
              </button>
            </form>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>
